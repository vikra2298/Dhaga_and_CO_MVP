{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "installCommand": "pip install -r requirements.txt",
      "functions": {
        "backend/main.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
