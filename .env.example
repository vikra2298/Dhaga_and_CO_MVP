# Copy to .env and fill in. Never commit real keys.

# Model A — cheap / bulk. Every row. Groq free tier.
MODEL_A_API_KEY=
MODEL_A_NAME=openai/gpt-oss-20b
MODEL_A_BASE_URL=https://api.groq.com/openai/v1

# Model B — stronger. Only rows under 75% or failed validation.
MODEL_B_API_KEY=
MODEL_B_NAME=openai/gpt-oss-120b
MODEL_B_BASE_URL=https://api.groq.com/openai/v1

# Production: comma-separated frontend origins (Vercel also matched via *.vercel.app).
# CORS_ORIGINS=https://your-app.vercel.app

# Optional
APP_ENV=local

# Frontend (Vercel project env): API origin with no trailing slash.
# VITE_API_BASE=https://dhaga-return-api.onrender.com
